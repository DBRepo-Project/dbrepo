<GetRecord>
    <record>
        <header>
            <identifier>[[${pid}]]</identifier>
            <datestamp>[[${datestamp}]]</datestamp>
        </header>
        <metadata>
            <oai_dc:dc
                    xmlns="http://www.openarchives.org/OAI/2.0/oai_dc/"
                    xmlns:oai_dc="http://www.openarchives.org/OAI/2.0/oai_dc/"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xmlns:dc="http://purl.org/dc/elements/1.1/"
                    xsi:schemaLocation="http://www.openarchives.org/OAI/2.0/oai_dc/ http://www.openarchives.org/OAI/2.0/oai_dc.xsd">
                <dc:identifier>[[${pid}]]</dc:identifier>
                <dc:title th:each="title: ${identifier.titles}" th:xmllang="${title.language}">[[${title.title}]]</dc:title>
                <dc:publisher>[[${identifier.publisher}]]</dc:publisher>
                <dc:description th:each="description: ${identifier.descriptions}" th:xmllang="${description.language}">[[${description.description}]]</dc:description>
                <dc:creator th:each="creator: ${identifier.creators}">[[${creator.creatorName}]]</dc:creator>
            </oai_dc:dc>
        </metadata>
    </record>
</GetRecord>