FROM docker:27-dind AS runtime

ENV CI_GPG_SECRING=""
ENV CI_GPG_PUBRING=""

RUN apk add --no-cache sed helm make gpg gpg-agent
RUN mkdir -m 0700 -p ~/.gnupg
RUN echo "${CI_GPG_SECRING}" | base64 -d > ~/.gnupg/secring.gpg
RUN echo "${CI_GPG_PUBRING}" | base64 -d > ~/.gnupg/pubring.gpg

RUN gpg --list-keys