    "@ava/babel": "^1.0.1",
    "@babel/core": "^7.14.3",
    "@babel/preset-env": "^7.14.4",
    "@babel/register": "^7.13.16",
    "@nuxt/test-utils": "^0.2.2",
    "@nuxtjs/eslint-config": "^3.1.0",
    "@vue/test-utils": "^1.2.0",
    "ava": "^3.15.0",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^27.0.2",
    "babel-plugin-module-resolver": "^4.1.0",
    "consola": "^2.15.3",
    "cross-env": "^7.0.3",
    "css-loader": "^5.2.6",
    "eslint-plugin-nuxt": "^1.0.0",
    "jest": "^27.0.2",
    "jsdom": "^16.6.0",
    "jsdom-global": "^3.0.2",
